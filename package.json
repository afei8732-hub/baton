{
  "name": "baton-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Baton - handoff context briefs for Jira, built on Atlassian Forge",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@forge/cli": "^16.0.0",
    "@forge/manifest": "^13.7.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@forge/api": "^8.5.1",
    "@forge/bridge": "^7.4.0",
    "@forge/kvs": "^2.1.3"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.ui.json",
    "test": "vitest run",
    "verify": "npm run build && node scripts/verify.mjs",
    "screenshots": "python3 scripts/screenshots.py",
    "demo": "python3 scripts/demo.py",
    "dev": "vite"
  }
}
